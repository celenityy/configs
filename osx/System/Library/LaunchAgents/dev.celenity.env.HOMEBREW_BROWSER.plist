<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.celenity.env.HOMEBREW_BROWSER</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/launchctl</string>
        <string>setenv</string>
        <string>HOMEBREW_BROWSER</string>
        <string>/Users/user/Applications/Firefox.app/Contents/MacOS/firefox -P default-release</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
