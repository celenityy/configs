# curl config file

### NOTE TO SELF: REPLACE [XXXXXX] BELOW

## Use DNS over HTTPS
--doh-url https://firefox.dns.nextdns.io/[XXXXXX]/Linux%20curl

## Verify DoH server certificate
--doh-cert-status

## Disable insecure connections
--no-insecure
--no-proxy-insecure
--no-ssl
--no-ssl-allow-beast

## Disable session identifiers
--no-sessionid

## Disable TLS 1.3 0-RTT
--no-tls-earlydata

## Enable Certificate Revocation Checks
--no-ssl-no-revoke

## Enable Encrypted Client Hello
# Not supported on Fedora's curl :(
#--ech true

## Enable OCSP Stapling
--cert-status

## Enforce HTTPS
--proto -all,https

## Enforce TLS 1.3
# Too strict :(
#--tlsv1.3

## Hard-fail Certificate Revocation Checks
--no-ssl-revoke-best-effort

## Prevent automatic location and use of client certificates for authentication
--no-ssl-auto-client-cert

## Require HTTPS for redirects
--proto-redir -all,https

## Show error messages
--show-error

## Use HTTPS by default
--proto-default https
